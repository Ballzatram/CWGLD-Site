{
  "schema_version": 1,
  "framework_version": "1.0.0",
  "framework_source": ".engineering",
  "owner": "Ballzatram",
  "repository": "Ballzatram/CWGLD-Site",
  "risk_tier": "standard",
  "lifecycle": "active",
  "profiles": [
    "other-languages",
    "web"
  ],
  "commands": {
    "format": "npx --yes prettier@3.10.0 --check \"*.html\" \"**/*.css\" \"**/*.js\"",
